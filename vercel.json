      "permanent": true
    },
    {
      "source": "/equipamentos/computadores-e-tablets",
      "destination": "/catalogo",
      "permanent": true
    },
    {
      "source": "/equipamentos/hds-e-cartoes-de-memoria",
      "destination": "/catalogo",
      "permanent": true
    },
    {
      "source": "/equipamentos/gravadores",
      "destination": "/catalogo",
      "permanent": true
    },
    {
      "source": "/equipamentos/cameras-ptz/:slug",
      "destination": "/equipamentos/cameras/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/luz/:slug",
      "destination": "/equipamentos/iluminacao/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/lentes-e-mount/:slug",
      "destination": "/equipamentos/lentes/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/lentes-ef-mount/:slug",
      "destination": "/equipamentos/lentes/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/lentes-pl-mount/:slug",
      "destination": "/equipamentos/lentes/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/lentes-rf-mount/:slug",
      "destination": "/equipamentos/lentes/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/lentes-broadcast/:slug",
      "destination": "/equipamentos/lentes/:slug",
      "permanent": true
    },
    {
      "source": "/equipamentos/tripes/:slug",
      "destination": "/catalogo/tripes-de-camera",
      "permanent": true
    },
    {
      "source": "/equipamentos/still/:slug",
      "destination": "/catalogo/flash",
      "permanent": true
    },
    {
      "source": "/equipamentos/suporte-e-movimento/:slug",
      "destination": "/catalogo/movimento",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src 'self' https://www.google.com https://maps.google.com; media-src 'self' blob: https:; worker-src 'self' blob:; form-action 'self' https://wa.me https://api.whatsapp.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
